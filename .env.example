# FinPal Environment Variables Configuration
# Tất cả config đã được cấu hình sẵn trong docker-compose.yml
# File này chỉ để tham khảo

# ========================================
# MySQL Database
# ========================================
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=finpal_db
MYSQL_PORT=3306

# ========================================
# Backend Java (Spring Boot)
# ========================================
BACKEND_PORT=8080
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/finpal_db?characterEncoding=UTF-8&useUnicode=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=root

# JWT Configuration
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION=86400000

# AI Service URL
AI_BACKEND_URL=http://backend-ai:8000

# ========================================
# Backend AI (FastAPI)
# ========================================
AI_BACKEND_PORT=8000
MODEL_PATH=/app/models

# ========================================
# phpMyAdmin
# ========================================
PMA_PORT=8081
PMA_HOST=mysql

# ========================================
# Lưu ý:
# ========================================
# - Không cần tạo file .env vì tất cả đã config trong docker-compose.yml
# - File này chỉ để tham khảo các biến môi trường
# - Để chạy: docker-compose up -d
