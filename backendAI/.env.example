# Application
APP_NAME=Finpal AI Backend
APP_VERSION=1.0.0
DEBUG=True
PORT=8000

# API
API_PREFIX=/api
API_VERSION=v1

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Database (MySQL - optional, for direct DB access)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=finpal_db
DB_USER=root
DB_PASSWORD=123456

# Model Settings
MODEL_PATH=data/models
RETRAIN_INTERVAL=7  # days

# Java Backend Integration
JAVA_BACKEND_URL=http://localhost:8080

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# ML Model Parameters
CATEGORIZATION_MODEL=random_forest
ANOMALY_THRESHOLD=0.7
PREDICTION_WINDOW=30  # days
