{
  "properties": [
    {
      "name": "jwt.secret",
      "type": "java.lang.String",
      "description": "Secret key for JWT token signing (Base64 encoded)"
    },
    {
      "name": "jwt.expiration",
      "type": "java.lang.Long",
      "description": "JWT token expiration time in milliseconds",
      "defaultValue": 604800000
    },
    {
      "name": "ai.backend.url",
      "type": "java.lang.String",
      "description": "URL of the AI backend service"
    },
    {
      "name": "ai.backend.enabled",
      "type": "java.lang.Boolean",
      "description": "Enable/disable AI backend integration",
      "defaultValue": true
    },
    {
      "name": "ai.confidence.threshold",
      "type": "java.lang.Double",
      "description": "Minimum confidence threshold for AI categorization",
      "defaultValue": 0.70
    },
    {
      "name": "scheduler.notifications.enabled",
      "type": "java.lang.Boolean",
      "description": "Enable/disable notification scheduler",
      "defaultValue": true
    },
    {
      "name": "scheduler.notifications.budget-alerts.cron",
      "type": "java.lang.String",
      "description": "Cron expression for budget alerts"
    },
    {
      "name": "scheduler.notifications.savings-suggestions.cron",
      "type": "java.lang.String",
      "description": "Cron expression for savings suggestions"
    },
    {
      "name": "scheduler.notifications.spending-insights.cron",
      "type": "java.lang.String",
      "description": "Cron expression for spending insights"
    },
    {
      "name": "scheduler.notifications.cleanup.cron",
      "type": "java.lang.String",
      "description": "Cron expression for notification cleanup"
    }
  ]
}
